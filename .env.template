# ============ 服务端 ============
# LLM 配置（用户自行填写；填之前项目以 LLM_MODE=mock 运行，填好后改 real）
LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BACKUP_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=15
LLM_TEMPERATURE_PARSE=0.1
LLM_TEMPERATURE_FILL=0.3

# 数据库
PG_URL=postgresql+psycopg://postgres:postgres@localhost:5432/design
# 开发默认走 Docker 里的 PG；宿主端口冲突时改这里
REDIS_URL=redis://localhost:6380/0

# 存储
STORAGE_ROOT=./designs/images

# 鉴权
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# 可观测
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 端口
BACKEND_PORT=8000
Y_WEBSOCKET_URL=ws://localhost:1234

# ============ 前端（复制为 frontend/.env.local 或由 Vite 读取） ============
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:1234
